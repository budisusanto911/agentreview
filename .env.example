# GitHub Personal Access Token (PAT) dengan akses `repo` atau `pull-requests: write`
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Secret string yang sama dengan yang diisi di form GitHub Webhook Settings
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key

# API Key untuk LLM (Gemini API)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Konfigurasi Model (Default: gemini-2.5-pro atau gemini-2.5-flash)
AI_MODEL=gemini-2.5-pro

# Port Server Webhook
PORT=8000

